{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DocumentValidation": {
    "Security": {
      "ApiKeys": []
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Files": {
      "MaxBytes": 10485760,
      "AllowedTypes": [ "application/pdf", "image/jpeg", "image/png" ]
    },
    "RateLimit": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Catalog": {
      "FilePath": "configuration/validation-catalog.json"
    },
    "Audit": {
      "RetentionDays": 30
    }
  }
}
