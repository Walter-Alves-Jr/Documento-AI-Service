{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DocumentValidation": "Host=localhost;Port=5432;Database=document_validation;Username=document_validation"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "DataProtection": {
    "KeysDirectory": ""
  },
  "DocumentValidation": {
    "Security": {
      "ApiKeys": []
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "Files": {
      "MaxBytes": 10485760,
      "AllowedTypes": [ "application/pdf", "image/jpeg", "image/png" ]
    },
    "RateLimit": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Catalog": {
      "FilePath": "configuration/validation-catalog.json"
    },
    "Audit": {
      "RetentionDays": 30
    },
    "Renewal": {
      "Enabled": false,
      "LeadDays": 3,
      "ScanIntervalMinutes": 60
    },
    "CrossValidation": {
      "InconsistencyOutcome": "pending_validation"
    }
  }
}
